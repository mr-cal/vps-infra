# Production environment for the bm-tracker container.
#
# Separate from /opt/vps-infra/.env on purpose. That file is shared with
# craft-dashboard and llm-evaluate and sets DATABASE_URL to craft-dashboard's
# Postgres; a container that inherited it would point itself at the wrong
# database. Two apps, two files, so neither can influence the other's config.
#
# SETUP, once, by hand:
#   cp /opt/vps-infra/.env.bm-tracker.example /opt/vps-infra/.env.bm-tracker
#   printf 'SESSION_SECRET=%s\n' "$(openssl rand -base64 48)" >> /opt/vps-infra/.env.bm-tracker
#   chmod 600 /opt/vps-infra/.env.bm-tracker
#
# SECURITY: chmod 600. Never commit the real file.

# Session cookie signing key. Required in production and must be at least 32
# bytes; the app refuses to start without it. Rotating it signs everyone out.
SESSION_SECRET=

# The database is a SQLite file, not a server. Four slashes: three gives a path
# relative to the working directory, which is how a production deploy ends up
# writing inside the container and losing everything on the next rebuild.
DATABASE_URL=sqlite+aiosqlite:////data/bm_tracker.db

# Embeddings for the note-achievement matcher. Without it the matcher is off and
# the thirty-eight note achievements cannot be earned; nothing else is affected.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1024
