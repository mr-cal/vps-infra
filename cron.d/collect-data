# craft-dashboard open-issue and release refresh every 10 minutes.
# flock: a gated pass takes ~2.5 min (post Tier-1/2), but without a lock a
# slow pass would pile up instances and saturate this 1-vCPU VPS
# (2026-11-23). A tick is skipped while the previous pass (or another
# collector) is still running.
*/10 * * * * root flock -n /run/lock/collect-data.lock podman exec -i vps-infra_craft-dashboard_1 /app/.venv/bin/python /app/scripts/collect_data.py --source github --mode open >> /var/log/collect-data.log 2>&1

# craft-dashboard hourly full-project refresh rotation — picks whichever
# project+source (GitHub or Launchpad) has gone longest without a full
# refresh and fully refreshes just that one. Runs hourly so the rotation
# cycles through every project roughly once a day. Replaces the old
# fixed "--mode full" cron job, which was per-project gated to once
# every 7 days (see craft_dashboard/config.py: refresh_interval_days)
# and left every project's full-refresh timestamp days-to-weeks stale.
# Shares the open-pass lock so a full refresh never overlaps it.
17 * * * * root flock -n /run/lock/collect-data.lock podman exec -i vps-infra_craft-dashboard_1 /app/.venv/bin/python /app/scripts/collect_data.py --mode rotation >> /var/log/collect-data.log 2>&1

# craft-dashboard forum activity backfill+refresh (snapcraft/charmhub/rockcraft Discourse) — every 15 minutes.
# Shares the collect-data lock: all three collector jobs serialize on
# /run/lock/collect-data.lock so the box runs at most one collector at a time.
*/15 * * * * root flock -n /run/lock/collect-data.lock podman exec -i vps-infra_craft-dashboard_1 /app/.venv/bin/python /app/scripts/collect_forum_data.py --mode all >> /var/log/collect-data.log 2>&1
