# Production environment for the VPS (/opt/vps-infra/.env).
# Shared by craft-dashboard and llm-evaluate containers.
# SECURITY: chmod 600 /opt/vps-infra/.env

# PostgreSQL connection string (password must match DB_PASSWORD secret)
DATABASE_URL=postgresql+asyncpg://craft_dashboard:<password>@postgres/craft_dashboard

# GitHub fine-grained token with read access to public repos (for collector cron)
GITHUB_TOKEN=

# Admin bearer token for /api/admin/* endpoints
ADMIN_TOKEN=

# Eval API bearer token for /api/eval/* endpoints
EVAL_API_TOKEN=

# API key for server-side text embeddings (semantic search & eval embeddings)
EMBEDDING_API_KEY=

# Internal URL of craft-dashboard for the evaluation worker container
DASHBOARD_URL=http://craft-dashboard:8000

# OpenAI-compatible LLM endpoint & credentials for the evaluation worker container
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL_SUMMARY=stealth/space-bunny-alpha
LLM_MODEL_SCORING=stealth/space-bunny-alpha

# Retention window in days for superseded evaluation transcripts
EVAL_TRANSCRIPT_RETENTION_DAYS=30

# FastAPI debug mode (shows tracebacks in the browser)
DEBUG=false

# Log level for scripts (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
